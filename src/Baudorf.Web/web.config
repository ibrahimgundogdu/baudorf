<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS-Konfiguration für das ASP.NET Core Module. Beim Publish aktualisiert das SDK das
  <aspNetCore>-Element (Pfad/Argumente) automatisch; die übrigen Einträge bleiben erhalten.
  WICHTIG: maxAllowedContentLength hebt das IIS-Standardlimit (~28,6 MB) an, damit Video-
  Uploads bis 90 MB durchgehen (App-Limit: Bilder 12 MB / Videos 80 MB in UploadValidation).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Baudorf.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 90 MB (94.371.840 Bytes) -->
          <requestLimits maxAllowedContentLength="94371840" />
        </requestFiltering>
      </security>
      <!--
        Kanonische Domain: www.baudorf.de dauerhaft (301) auf https://baudorf.de umleiten.
        Läuft auf IIS-Ebene VOR der App. Voraussetzung: IIS "URL Rewrite"-Modul installiert
        (sonst startet die Site nicht → 500.19). Query-String bleibt via appendQueryString erhalten.
      -->
      <rewrite>
        <rules>
          <rule name="www-to-non-www" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^www\.baudorf\.de$" />
            </conditions>
            <action type="Redirect" url="https://baudorf.de/{R:1}" redirectType="Permanent" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>
