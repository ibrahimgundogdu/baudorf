@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Passwort ändern";
    ViewData["MetaDescription"] = "Ändern Sie das Passwort Ihres Baudorf-Kontos.";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="hx-pagehead">
    <img class="hx-pagehead__emblem" src="~/img/brand/baudorf-emblem-gold.png" alt="" />
    <div class="hx-wrap">
        <div class="hx-eyebrow"><span>Mein Konto</span></div>
        <h1>Passwort <em class="hx-em">ändern</em></h1>
        <p>Wählen Sie ein starkes, einzigartiges Passwort (mindestens 8 Zeichen, mit Groß-/Kleinbuchstaben, Ziffer und Sonderzeichen).</p>
    </div>
</section>

<div class="hx-wrap">
    <div class="hx-auth">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="hx-2fahub__status">@Model.StatusMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="hx-vsum"></div>

            <div class="hx-field">
                <label asp-for="Input.OldPassword">Aktuelles Passwort</label>
                <input asp-for="Input.OldPassword" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.OldPassword"></span>
            </div>
            <div class="hx-field">
                <label asp-for="Input.NewPassword">Neues Passwort</label>
                <input asp-for="Input.NewPassword" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="Input.NewPassword"></span>
            </div>
            <div class="hx-field">
                <label asp-for="Input.ConfirmPassword">Neues Passwort bestätigen</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <div style="margin-top:1.4rem">
                <button type="submit" class="hx-btn hx-btn--gold">Passwort aktualisieren</button>
            </div>
        </form>

        <p class="hx-auth__alt">
            <a asp-page="./TwoFactorAuthentication">Zwei-Faktor-Authentifizierung verwalten</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
