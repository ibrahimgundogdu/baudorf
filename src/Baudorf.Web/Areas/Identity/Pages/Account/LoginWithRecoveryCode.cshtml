@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Wiederherstellungscode";
    ViewData["MetaDescription"] = "Melden Sie sich mit einem Wiederherstellungscode an.";
}

<section class="hx-pagehead">
    <img class="hx-pagehead__emblem" src="~/img/brand/baudorf-emblem-gold.png" alt="" />
    <div class="hx-wrap">
        <div class="hx-eyebrow"><span>Sicherheit</span></div>
        <h1>Wiederherstellungs-<em class="hx-em">code</em></h1>
        <p>Kein Zugriff auf Ihre Authenticator-App? Geben Sie einen Ihrer gespeicherten Wiederherstellungscodes ein. Jeder Code ist nur einmal gültig.</p>
    </div>
</section>

<div class="hx-wrap">
    <div class="hx-auth">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="hx-vsum"></div>

            <div class="hx-field">
                <label asp-for="Input.RecoveryCode">Wiederherstellungscode</label>
                <input asp-for="Input.RecoveryCode" autocomplete="off" placeholder="xxxxx-xxxxx" autofocus aria-required="true" />
                <span asp-validation-for="Input.RecoveryCode"></span>
            </div>

            <div style="margin-top:1.4rem">
                <button type="submit" class="hx-btn hx-btn--gold">Anmelden</button>
            </div>
        </form>

        <p class="hx-auth__alt">
            Doch Zugriff auf die App?
            <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl">Mit Authenticator-Code anmelden</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
