@model List<Leistung>
@{
    ViewData["Title"] = "Leistungen";
}

<div class="bd-toolbar">
    <h2>Leistungen</h2>
    <a class="bd-btn bd-btn--gold bd-btn--sm" asp-action="Create">+ Neue Leistung</a>
</div>

<table class="bd-table">
    <thead>
        <tr><th></th><th>#</th><th>Titel</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="bd-empty-row">Noch keine Leistungen.</td></tr>
        }
        @foreach (var l in Model)
        {
            <tr>
                <td>@if (!string.IsNullOrWhiteSpace(l.CoverUrl)) { <img class="bd-thumb" src="@l.CoverUrl" alt="" /> }</td>
                <td>@l.Reihenfolge</td>
                <td><strong>@l.Titel</strong><br /><span class="bd-muted">@l.Slug</span></td>
                <td>
                    @if (l.IstVeroeffentlicht) { <span class="bd-pill bd-pill--ok">Veröffentlicht</span> }
                    else { <span class="bd-pill bd-pill--muted">Entwurf</span> }
                </td>
                <td class="bd-table__actions">
                    <a class="bd-btn bd-btn--ink bd-btn--xs" asp-action="Edit" asp-route-id="@l.Id">Bearbeiten</a>
                    <form method="post" asp-action="Delete" asp-route-id="@l.Id" onsubmit="return confirm('Leistung löschen?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bd-btn bd-btn--danger bd-btn--xs">Löschen</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
