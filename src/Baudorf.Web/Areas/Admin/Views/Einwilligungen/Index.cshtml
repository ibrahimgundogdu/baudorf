@model EinwilligungenViewModel
@{
    ViewData["Title"] = "Einwilligungen";

    string ActionLabel(string a) => a switch
    {
        "accept" => "Alle akzeptiert",
        "reject" => "Abgelehnt",
        "custom" => "Angepasst",
        _ => a
    };
}

<p class="bd-muted" style="margin:0 0 1.2rem;max-width:70ch;">
    Nachweis der Cookie-Einwilligung gemäß DSGVO (Art. 5 Abs. 2 / Art. 7). Die IP wird
    anonymisiert gespeichert (Datenminimierung); es werden keine personenbezogenen Profile gebildet.
    Angezeigt werden die letzten 300 Einträge.
</p>

<div class="bd-stats" style="margin-bottom:1.6rem;">
    <div class="bd-stat">
        <span class="bd-stat__num">@Model.Gesamt</span>
        <span class="bd-stat__label">Einwilligungen gesamt</span>
    </div>
    <div class="bd-stat">
        <span class="bd-stat__num">@Model.Akzeptiert</span>
        <span class="bd-stat__label">Alle akzeptiert</span>
    </div>
    <div class="bd-stat">
        <span class="bd-stat__num">@Model.Abgelehnt</span>
        <span class="bd-stat__label">Abgelehnt</span>
    </div>
    <div class="bd-stat">
        <span class="bd-stat__num">@Model.Angepasst</span>
        <span class="bd-stat__label">Angepasst</span>
    </div>
</div>

<table class="bd-table bd-table--compact">
    <thead>
        <tr>
            <th>Zeitpunkt</th>
            <th>Entscheidung</th>
            <th>Kategorien</th>
            <th>Version</th>
            <th>IP (anonym.)</th>
            <th>Referenz</th>
            <th>User-Agent</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Eintraege.Count == 0)
        {
            <tr><td colspan="7" class="bd-empty-row">Noch keine Einwilligungen protokolliert.</td></tr>
        }
        @foreach (var c in Model.Eintraege)
        {
            <tr>
                <td>@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@ActionLabel(c.Aktion)</td>
                <td class="bd-muted">@c.Kategorien</td>
                <td>@c.Version</td>
                <td>@(c.IpAnonymisiert ?? "—")</td>
                <td class="bd-muted" style="font-family:monospace;font-size:12px;">@c.Referenz.ToString()[..8]</td>
                <td class="bd-muted" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.UserAgent</td>
            </tr>
        }
    </tbody>
</table>
