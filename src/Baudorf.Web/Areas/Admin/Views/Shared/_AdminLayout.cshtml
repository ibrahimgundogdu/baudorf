<!DOCTYPE html>
<html lang="de" data-pal="gold">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Baudorf Admin</title>
    <link rel="icon" type="image/png" href="~/img/brand/baudorf-emblem-ink.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
</head>
@{
    var curCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Act(string c) => string.Equals(curCtrl, c, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<body class="bd-admin">
    <aside class="bd-admin__nav">
        <a class="bd-admin__brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
            <img src="~/img/brand/baudorf-logo-full.png" alt="Baudorf" />
        </a>
        <a class="bd-admin__back" asp-area="" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            Zur Website
        </a>

        <nav>
            <span class="bd-admin__group">Übersicht</span>
            <a class="@Act("Home")" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>

            <span class="bd-admin__group">Inhalte</span>
            <a class="@Act("Properties")" asp-area="Admin" asp-controller="Properties" asp-action="Index">Immobilien</a>
            <a class="@Act("Blog")" asp-area="Admin" asp-controller="Blog" asp-action="Index">Aktuelles</a>
            <a class="@Act("Leistung")" asp-area="Admin" asp-controller="Leistung" asp-action="Index">Leistungen</a>
            <a class="@Act("HomeContent")" asp-area="Admin" asp-controller="HomeContent" asp-action="Index">Startseite</a>
            <a class="@Act("Team")" asp-area="Admin" asp-controller="Team" asp-action="Index">Team</a>
            <a class="@Act("Media")" asp-area="Admin" asp-controller="Media" asp-action="Index">Mediathek</a>
            <a class="@Act("Legal")" asp-area="Admin" asp-controller="Legal" asp-action="Index">Rechtstexte</a>

            <span class="bd-admin__group">Anfragen &amp; DSGVO</span>
            <a class="@Act("Leads")" asp-area="Admin" asp-controller="Leads" asp-action="Index">Anfragen</a>
            <a class="@Act("Widerruf")" asp-area="Admin" asp-controller="Widerruf" asp-action="Index">Widerrufe</a>
            <a class="@Act("Einwilligungen")" asp-area="Admin" asp-controller="Einwilligungen" asp-action="Index">Einwilligungen</a>

            <span class="bd-admin__group">System</span>
            <a class="@Act("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">Benutzer</a>
            <a class="@Act("Activity")" asp-area="Admin" asp-controller="Activity" asp-action="Index">Aktivität</a>
            <a class="@Act("Settings")" asp-area="Admin" asp-controller="Settings" asp-action="Index">Einstellungen</a>
        </nav>
    </aside>

    <main class="bd-admin__main">
        <header class="bd-admin__head">
            <div>
                <span class="bd-admin__crumb">Verwaltung</span>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="bd-admin__user">
                <span class="bd-admin__user-name">@User.Identity?.Name</span>
                <a class="bd-admin__konto" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Konto &amp; Sicherheit</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="bd-admin__logout">Abmelden</button>
                </form>
            </div>
        </header>
        <div class="bd-admin__content">
            @if (TempData["Success"] is string ok)
            {
                <div class="bd-flash bd-flash--ok">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="bd-flash bd-flash--err">@err</div>
            }
            @RenderBody()
        </div>
    </main>
    <partial name="_MediaPicker" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="~/js/admin-media.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
