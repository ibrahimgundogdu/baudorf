@model List<Property>
@{
    ViewData["Title"] = L["Immobilien"];
}

<div class="bd-toolbar">
    <form method="get" class="bd-inline-search">
        <input type="text" name="q" value="@ViewData["q"]" placeholder="@L["Suchen…"]" />
        <button class="bd-btn bd-btn--plain bd-btn--xs" type="submit">@L["Suchen"]</button>
    </form>
    <span style="display:flex;gap:.5rem;">
        <a class="bd-btn bd-btn--plain bd-btn--sm" asp-action="Papierkorb">@L["Papierkorb"]@(ViewData["TrashCount"] is int tc && tc > 0 ? $" ({tc})" : "")</a>
        <a class="bd-btn bd-btn--gold bd-btn--sm" asp-action="Create">+ @L["Neues Objekt"]</a>
    </span>
</div>

<table class="bd-table">
    <thead>
        <tr>
            <th></th>
            <th>@L["Titel"]</th>
            <th>@L["Art"]</th>
            <th>@L["Status"]</th>
            <th>@L["Sichtbarkeit"]</th>
            <th>@L["Preis"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="bd-empty-row">@L["Noch keine Objekte. Legen Sie das erste an."]</td></tr>
        }
        @foreach (var p in Model)
        {
            var cover = p.CoverUrl();
            <tr>
                <td>
                    @if (cover != null)
                    {
                        <img class="bd-thumb" src="@cover" alt="" />
                    }
                    else
                    {
                        <img class="bd-thumb" src="~/img/brand/baudorf-emblem-ink.png" alt="" />
                    }
                </td>
                <td>
                    <strong>@p.Titel</strong><br />
                    <span class="bd-muted">@(string.IsNullOrWhiteSpace(p.Region) ? p.Land : p.Region)</span>
                </td>
                <td>@p.Art.Label()</td>
                <td>@p.Status.Label()</td>
                <td>
                    @if (p.IstVeroeffentlicht)
                    {
                        <span class="bd-pill bd-pill--ok">@L["Veröffentlicht"]</span>
                    }
                    else
                    {
                        <span class="bd-pill bd-pill--muted">@L["Entwurf"]</span>
                    }
                    @if (p.IstOffMarket) { <span class="bd-pill bd-pill--dark">Off-Market</span> }
                    @if (p.IstFeatured) { <span class="bd-pill bd-pill--gold">Featured</span> }
                </td>
                <td>@p.PreisText()</td>
                <td class="bd-table__actions">
                    <a class="bd-btn bd-btn--plain bd-btn--xs" asp-controller="Immobilien" asp-area="" asp-action="Details" asp-route-slug="@p.Slug" target="_blank">@L["Ansehen"]</a>
                    <a class="bd-btn bd-btn--ink bd-btn--xs" asp-action="Edit" asp-route-id="@p.Id">@L["Bearbeiten"]</a>
                    @* Löschen bewusst NICHT in der Liste — nur auf der Bearbeiten-Seite (verhindert Fehlklicks). *@
                </td>
            </tr>
        }
    </tbody>
</table>
