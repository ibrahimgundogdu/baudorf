@model HomeSection
@{
    ViewData["Title"] = $"Abschnitt: {Model.Key}";

    // Pro Abschnitt nur die Felder zeigen, die auf der Startseite tatsächlich verwendet werden.
    var key = Model.Key;
    bool showOverline = key is "hero" or "philosophie" or "leistungen" or "statement" or "vorgehen" or "klientel" or "ueber-uns" or "tippgeber" or "karriere" or "insights" or "kontakt";
    // Testimonial nutzt jetzt Listenelemente (mehrere rotierende Stimmen) → Einzel-Text/Titel aus.
    bool showTitel = key != "zahlen" && key != "testimonial";
    bool showText = key is "hero" or "philosophie" or "leistungen" or "statement" or "klientel" or "tippgeber" or "karriere" or "kontakt";
    bool showCta = key is "hero" or "statement" or "tippgeber" or "karriere" or "kontakt";
    bool showCta2 = key is "hero";
    bool showBild = key is "philosophie" or "statement" or "kontakt";
    string itemsMode = key switch { "hero" => "hero", "vorgehen" or "klientel" or "zahlen" or "ueber-uns" or "testimonial" => "list", _ => "none" };
    bool numberItems = key is "zahlen" or "ueber-uns"; // Titel = Wert/Zahl, Text = Beschriftung

    // Abschnittsspezifische Beschriftungen (klarere Bedeutung).
    string titelLabel = key == "testimonial" ? "Quelle / Autor (z. B. Family Office · Düsseldorf)" : "Titel (HTML <em> erlaubt für Gold-Kursiv)";
    string textLabel = key == "testimonial" ? "Zitat" : "Text";
    string itemsLegend = key switch {
        "zahlen" => "Zahlen (Titel = große Zahl, Text = Beschriftung darunter)",
        "ueber-uns" => "Kennzahlen (z. B. 1994 / Gegründet · Velbert / Sitz · NRW)",
        "vorgehen" => "Schritte (Titel + Text)",
        "klientel" => "Einträge (nur Titel)",
        "testimonial" => "Stimmen — je Eintrag: Zitat + Quelle (rotieren automatisch)",
        _ => "Listenelemente"
    };
}

<div class="bd-toolbar">
    <a class="bd-btn bd-btn--plain bd-btn--xs" asp-action="Index">&larr; Zurück</a>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data" class="bd-aform">
    @Html.AntiForgeryToken()
    <fieldset>
        <legend>Inhalt (@Model.Key)</legend>

        @if (showOverline)
        {
            <div class="bd-form-field">
                <label asp-for="Overline">Overline (kleine Überschrift)</label>
                <input asp-for="Overline" />
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Overline" />
        }

        @if (showTitel)
        {
            <div class="bd-form-field">
                <label asp-for="Titel">@titelLabel</label>
                <input asp-for="Titel" />
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Titel" />
        }

        @if (showText)
        {
            <div class="bd-form-field">
                <label asp-for="Text">@textLabel</label>
                <textarea asp-for="Text" rows="@(key == "testimonial" ? 4 : 4)"></textarea>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Text" />
        }

        @if (showCta)
        {
            <div class="bd-grid-2">
                <div class="bd-form-field"><label asp-for="CtaText">Button — Text</label><input asp-for="CtaText" /></div>
                <div class="bd-form-field"><label asp-for="CtaUrl">Button — Link</label><input asp-for="CtaUrl" /></div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="CtaText" /><input type="hidden" asp-for="CtaUrl" />
        }

        @if (showCta2)
        {
            <div class="bd-grid-2">
                <div class="bd-form-field"><label asp-for="Cta2Text">Button 2 — Text</label><input asp-for="Cta2Text" /></div>
                <div class="bd-form-field"><label asp-for="Cta2Url">Button 2 — Link</label><input asp-for="Cta2Url" /></div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Cta2Text" /><input type="hidden" asp-for="Cta2Url" />
        }

        <div class="bd-grid-2">
            <div class="bd-form-field"><label asp-for="Reihenfolge">Reihenfolge</label><input asp-for="Reihenfolge" type="number" /></div>
            <div class="bd-checkline" style="align-self:end;"><input asp-for="IstSichtbar" /> <label asp-for="IstSichtbar">Sichtbar</label></div>
        </div>

        @if (showBild)
        {
            <div class="bd-form-field">
                <label>Bild (Hintergrund / Medien)</label>
                @{
                    var secStyle = $"width:140px;height:auto;display:{(string.IsNullOrWhiteSpace(Model.BildUrl) ? "none" : "block")};margin-bottom:0.5rem;";
                }
                @if (DisplayHelpers.IsVideoUrl(Model.BildUrl))
                {
                    <video id="secBildPreview" class="bd-thumb" style="@secStyle" src="@Model.BildUrl" muted playsinline preload="metadata"></video>
                }
                else
                {
                    <img id="secBildPreview" class="bd-thumb" style="@secStyle" src="@Model.BildUrl" alt="" />
                }
                <input type="hidden" asp-for="BildUrl" id="secBildUrl" />
                <div style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;">
                    <button type="button" class="bd-btn bd-btn--plain bd-btn--xs" data-media-pick data-media-target="#secBildUrl" data-media-preview="#secBildPreview">Aus Mediathek wählen</button>
                    <span class="bd-muted">oder hochladen:</span>
                    <input type="file" name="bild" accept="image/*" />
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="BildUrl" />
        }
    </fieldset>
    <div class="bd-form-actions">
        <button type="submit" class="bd-btn bd-btn--gold">Abschnitt speichern</button>
    </div>
</form>

@if (itemsMode == "hero")
{
    <fieldset class="bd-aform" style="margin-top:2rem;">
        <legend>Hero-Slides (@Model.Items.Count)</legend>
        <p class="bd-muted" style="font-size:0.85rem;">Jeder Slide hat eigenes Bild, Overline, Titel und Untertitel. Die Buttons (CTA) oben gelten für alle Slides.</p>

        @foreach (var item in Model.Items.OrderBy(i => i.Reihenfolge))
        {
            <div class="bd-slide-card">
                <form method="post" asp-action="UpdateItem" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <div class="bd-slide-card__grid">
                        <div class="bd-slide-card__media">
                            @{
                                var slideDisplay = string.IsNullOrWhiteSpace(item.BildUrl) ? "none" : "block";
                                var slideStyle = $"width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:6px;display:{slideDisplay};";
                            }
                            @if (DisplayHelpers.IsVideoUrl(item.BildUrl))
                            {
                                <video id="slide_@(item.Id)_prev" class="bd-thumb" style="@slideStyle" src="@item.BildUrl" muted playsinline preload="metadata"></video>
                            }
                            else
                            {
                                <img id="slide_@(item.Id)_prev" class="bd-thumb" style="@slideStyle" src="@item.BildUrl" alt="" />
                            }
                            <input type="hidden" name="bildUrl" id="slide_@(item.Id)_url" value="@item.BildUrl" />
                            <button type="button" class="bd-btn bd-btn--plain bd-btn--xs" style="margin-top:.5rem;width:100%;" data-media-pick data-media-target="#slide_@(item.Id)_url" data-media-preview="#slide_@(item.Id)_prev">Bild wählen</button>
                        </div>
                        <div class="bd-slide-card__fields">
                            <div class="bd-form-field"><label>Overline</label><input name="overline" value="@item.Overline" placeholder="z. B. Off-Market · NRW" /></div>
                            <div class="bd-form-field"><label>Titel (HTML &lt;em&gt; = Gold-Kursiv)</label><input name="titel" value="@item.Titel" placeholder="Diskret. &lt;em&gt;Exklusiv.&lt;/em&gt; Direkt." /></div>
                            <div class="bd-form-field"><label>Untertitel</label><textarea name="text" rows="2">@item.Text</textarea></div>
                            <div class="bd-slide-card__actions">
                                <button type="submit" class="bd-btn bd-btn--gold bd-btn--xs">Speichern</button>
                                <button formaction="@Url.Action("MoveItem", new { id = Model.Id })" name="direction" value="-1" class="bd-btn bd-btn--plain bd-btn--xs">↑</button>
                                <button formaction="@Url.Action("MoveItem", new { id = Model.Id })" name="direction" value="1" class="bd-btn bd-btn--plain bd-btn--xs">↓</button>
                                <button formaction="@Url.Action("DeleteItem", new { id = Model.Id })" class="bd-btn bd-btn--danger bd-btn--xs" onclick="return confirm('Slide löschen?');">Löschen</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        }

        <form method="post" asp-action="AddItem" asp-route-id="@Model.Id" style="margin-top:1rem;">
            @Html.AntiForgeryToken()
            <button type="submit" class="bd-btn bd-btn--ink bd-btn--sm">+ Neuen Slide hinzufügen</button>
        </form>
    </fieldset>
}
else if (itemsMode == "list")
{
    <fieldset class="bd-aform" style="margin-top:2rem;">
        <legend>@itemsLegend (@Model.Items.Count)</legend>

        @foreach (var item in Model.Items.OrderBy(i => i.Reihenfolge))
        {
            <form method="post" asp-action="UpdateItem" asp-route-id="@Model.Id" class="bd-item-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="itemId" value="@item.Id" />
                <input name="titel" value="@item.Titel" placeholder="@(numberItems ? "Zahl (z. B. 480 Mio. €)" : (key == "testimonial" ? "Quelle / Autor" : "Titel"))" />
                @if (key == "klientel")
                {
                    <input type="hidden" name="text" value="@item.Text" />
                }
                else
                {
                    <input name="text" value="@item.Text" placeholder="@(numberItems ? "Beschriftung" : (key == "testimonial" ? "Zitat" : "Text"))" />
                }
                <button type="submit" class="bd-btn bd-btn--plain bd-btn--xs">Speichern</button>
                <span class="bd-item-row__btns">
                    <button formaction="@Url.Action("MoveItem", new { id = Model.Id })" name="direction" value="-1" class="bd-btn bd-btn--plain bd-btn--xs">↑</button>
                    <button formaction="@Url.Action("MoveItem", new { id = Model.Id })" name="direction" value="1" class="bd-btn bd-btn--plain bd-btn--xs">↓</button>
                    <button formaction="@Url.Action("DeleteItem", new { id = Model.Id })" class="bd-btn bd-btn--danger bd-btn--xs" onclick="return confirm('Element löschen?');">×</button>
                </span>
            </form>
        }

        <form method="post" asp-action="AddItem" asp-route-id="@Model.Id" class="bd-item-row bd-item-row--add">
            @Html.AntiForgeryToken()
            <input name="titel" placeholder="@(numberItems ? "Neue Zahl" : (key == "testimonial" ? "Quelle / Autor" : "Neuer Titel"))" />
            <input name="text" placeholder="@(key == "klientel" ? "(leer lassen)" : (numberItems ? "Beschriftung" : (key == "testimonial" ? "Zitat" : "Neuer Text")))" />
            <button type="submit" class="bd-btn bd-btn--ink bd-btn--xs">+ Hinzufügen</button>
            <span></span>
        </form>
    </fieldset>
}
